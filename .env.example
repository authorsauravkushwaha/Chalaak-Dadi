# Copy to .env.local for local dev (never commit .env.local)
# PostgreSQL connection (Neon / Supabase / Vercel Postgres). Leave empty -> local demo store is used.
DATABASE_URL=
# Set PGSSL=disable only for a local Postgres without SSL
PGSSL=
# Secret required in header "x-ingest-secret" for POST /api/calls, /entities, /end. Leave empty -> ingestion disabled.
INGEST_SECRET=change-me-to-a-long-random-value
