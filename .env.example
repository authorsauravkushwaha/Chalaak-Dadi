# Copy to .env.local for local dev (never commit .env.local).
# Leave everything empty to run with the built-in demo store.

# --- Persistent database (RECOMMENDED for Vercel — without this, data is
# --- ephemeral on Vercel and may reset to the 3 seed cases) -------------
# Free PostgreSQL from neon.tech — paste the full connection string here.
# The app also accepts POSTGRES_URL / POSTGRES_PRISMA_URL /
# POSTGRES_URL_NON_POOLING / DATABASE_URL_UNPOOLED / NEON_DATABASE_URL,
# which is what the Vercel↔Neon integration injects automatically.
DATABASE_URL=

# Set PGSSL=disable only for a local Postgres without SSL.
PGSSL=

# Optional: max Postgres connections per server instance (default 10).
# Raise only when your database accepts the total across all instances.
PGPOOL_MAX=

# --- Ingestion secret ----------------------------------------------------
# Required in header "x-ingest-secret" for POST /api/calls,
# /api/calls/:id/entities and /api/calls/:id/end.
# Leave EMPTY (or as a short placeholder) -> ingestion stays safely
# DISABLED (the demo still works). Set a long random value to enable it,
# e.g. the output of:  openssl rand -hex 32
INGEST_SECRET=

# Optional: override the local demo-store file location (tests / custom).
# STORE_PATH=
